// prisma/schema.prisma — single source of truth for the data model.
//
// The Mermaid ER diagram in docs/diagrams/data-model.md is GENERATED from
// this file by the `erd` generator below — never hand-edit the diagram.
// Every `npx prisma generate` rewrites it, so it cannot drift.
//
// Medical records live in this SQL database ONLY. The blockchain stores
// access-log hashes, never patient data (GDPR, kickoff decision).

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/diagrams/data-model.md"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  doctor
  nurse
  ambulance
  primary_care
  patient
  unauthorized
}

enum NoteVisibility {
  private
  healthcare
  all
}

// ── Models ───────────────────────────────────────────────────────────────

/// Hospitals, clinics and ambulance services that users belong to.
model Organization {
  id   Int    @id @default(autoincrement())
  name String
  type String? // hospital | clinic | ambulance service

  users User[]
  @@map("organizations")
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  passwordHash   String   @map("password_hash")
  role           Role
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId Int?     @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  authoredRecords MedicalRecord[] @relation("record_author")
  authoredNotes   Note[]          @relation("note_author")
  accessLogs      AccessLog[]
  patient         Patient?

  @@map("users")
}

model Patient {
  id             Int      @id @default(autoincrement())
  personalNumber String   @unique @map("personal_number") // Swedish personnummer, 12 digits
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  dateOfBirth    DateTime @db.Date @map("date_of_birth")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User?    @relation(fields: [userId], references: [id])
  userId         Int?     @unique @map("user_id")

  records    MedicalRecord[]
  accessLogs AccessLog[]

  @@index([lastName, firstName], map: "idx_patients_name")
  @@map("patients")
}

/// Diagnoses, prescriptions, lab results, etc. — SQL only, never on-chain.
model MedicalRecord {
  id         Int      @id @default(autoincrement())
  recordType String   @map("record_type") // diagnosis | prescription | lab_result | ...
  content    String
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  Int      @map("patient_id")
  author     User     @relation("record_author", fields: [authorId], references: [id])
  authorId   Int      @map("author_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  notes       Note[]
  accessLogs  AccessLog[]

  @@index([patientId], map: "idx_medical_records_patient")
  @@map("medical_records")
}

/// Notes with visibility control attached to a record.
model Note {
  id         Int            @id @default(autoincrement())
  content    String
  visibility NoteVisibility
  record     MedicalRecord  @relation(fields: [recordId], references: [id])
  recordId   Int            @map("record_id")
  author     User           @relation("note_author", fields: [authorId], references: [id])
  authorId   Int            @map("author_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([recordId], map: "idx_notes_record")
  @@map("notes")
}

/// Audit trail of who viewed/edited what, and the durable outbox that anchors
/// each event on Solana. Task 15's homemade chain is replaced by this.
model AccessLog {
  id               Int      @id @default(autoincrement())
  /// Stable id shared with the peer and with the broadcast payload.
  eventId          String?  @unique @map("event_id")
  action           String // view | edit | create
  serverId         String   @map("server_id") // which of the two servers handled it
  user             User     @relation(fields: [userId], references: [id])
  userId           Int      @map("user_id")
  patient          Patient  @relation(fields: [patientId], references: [id])
  patientId        Int      @map("patient_id")
  record           MedicalRecord? @relation(fields: [recordId], references: [id])
  recordId         Int?     @map("record_id")

  // ── Outbox (task 26) ────────────────────────────────────────────────
  /// pending → anchored once the program returns a signature; failed is terminal.
  status           String   @default("pending")
  /// Solana slot. BigInt: slots exceed Number.MAX_SAFE_INTEGER.
  slot             BigInt?  @map("slot")
  signature        String?
  /// Chain head this event was anchored onto, hex.
  headHash         String?  @map("head_hash")
  /// Flusher attempts so far. Makes retry behaviour observable.
  attempt          Int      @default(0)
  /// Why the last attempt failed. Makes failure diagnosable.
  error            String?
  /// When a flusher claimed this row. Exclusivity is not crash-safe by itself:
  /// a process killed mid-flush would strand its rows forever without this.
  claimedAt        DateTime? @map("claimed_at")
  /// Client-supplied time. The chain slot remains the trusted clock.
  clientTime       DateTime @default(now()) @map("client_time")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([patientId], map: "idx_access_logs_patient")
  @@index([status, id], map: "idx_access_logs_status")
  @@map("access_logs")
}
