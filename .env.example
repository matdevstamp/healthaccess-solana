# Copy to .env and adjust. Never commit real .env files.

# Server identity — which of the two demo instances this is.
SERVER_ID=hospital-s          # or ambulance-a
PORT=3001                     # server 2 uses 3002

# Shared PostgreSQL database (both servers point at the same DB).
# Start it with: npm run db:up
DATABASE_URL="postgresql://healthaccess:healthaccess@localhost:5432/healthaccess"

# Auth
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="24h"

# P2P (tasks 15-16): the other server (derived from SERVER_ID unless set here).
PEER_URL="http://localhost:3002"
# How often each server pings its peer (ms).
PEER_HEARTBEAT_MS=10000

# Socket.IO CORS (task 18)
SOCKET_CORS_ORIGIN="http://localhost:3001,http://localhost:3002"

# Shared secret both server instances use to authenticate P2P calls
# (sent as the x-peer-secret header). Both instances must use the same value.
PEER_SECRET="dev-peer-secret-change-me"

# ── Solana (task 30) ───────────────────────────────────────────────────
# Read the chain and anchor access events. The app boots fine without these:
# an unset SOLANA_PROGRAM_ID reports programDeployed: false rather than
# crashing, so the off-chain audit view still works before the deploy.
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_CLUSTER="devnet"
SOLANA_COMMITMENT="confirmed"   # processed | confirmed | finalized

# Filled in after task 28's devnet deploy. Empty is a valid state.
SOLANA_PROGRAM_ID=

# Signing keypair. Deliberately outside the repo: there is exactly one and no
# clone can commit it.
SOLANA_KEYPAIR_PATH="~/.config/solana/devnet.json"

# Salts patient and user ids before they are hashed onto the chain, so the
# ledger holds pseudonymous accountability rather than linkable identity.
# NEVER COMMIT THIS. Generate with: openssl rand -hex 32
ACCESS_HASH_SALT=

# Optional: point at an Anchor build output instead of the default locations
# (./target/idl, ../ha-solana/target/idl).
# SOLANA_IDL_PATH="../ha-solana/target/idl/healthaccess_audit.json"
